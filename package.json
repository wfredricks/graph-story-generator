{
  "name": "graph-story-generator",
  "version": "0.1.0",
  "description": "Graph-constrained narrative generator — reads a PolyGraph SIG, generates goal-evaluated drafts",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format esm --dts",
    "dev": "npx tsx src/server.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1050.0",
    "@hono/node-server": "^2.0.1",
    "hono": "^4.12.18"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "engines": { "node": ">=18" }
}
